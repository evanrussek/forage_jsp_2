iv>\n      <md-card class="admin-settings-card">\n        <div layout="column">\n          <div class="disabled-settings-message-container"\n               ng-if="$ctrl.settings.dataRetention.disabled"\n               layout="row"\n               layout-align="start center">\n            <i class="material-icons grey-info-icon">\n              info\n            </i>\n            <div>\n              To make changes, visit your Google Analytics settings page.\n            </div>\n          </div>\n          <div class="event-data-retention-message">\n            You may change the retention period for data you send that is associated with cookies, user identifiers, or advertising identifiers. These controls do not affect most standard reporting, which is based on aggregated data. Google signals data (if enabled) is retained according to your setting or 26 months, whichever is less. Changes to these settings take effect after 24 hours.\n            <a href="https://support.google.com/firebase/answer/7663853"\n               target="_blank">\n              Learn more\n            </a>\n          </div>\n          <div class="event-data-retention-container">\n            <md-input-container class="settings-page-input">\n              <label>\n                Event data retention\n              </label>\n              <input ng-model="$ctrl.settings.dataRetention.value.eventDataRetentionMonths"\n                     ng-disabled="$ctrl.uiDisabled || $ctrl.settings.dataRetention.disabled"\n                     class="event-data-retention-field">\n            </md-input-container>\n          </div>\n          <div class="reset-user-data-toggle-container"\n               layout="row"\n               layout-align="start center">\n            <div class="reset-user-data-text">\n              Reset user data on new activity\n            </div>\n            <div>\n              <md-switch ng-model="$ctrl.settings.dataRetention.value.resetUserData"\n                         ng-di